ANTHROPIC_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
DATALAB_API_KEY=your_key_here

# Self-hosted OpenAI-compatible server (vLLM/Ollama), used by --generator local,
# --llm-backend local, and evaluate's --generator local. All optional -- each
# falls back to http://localhost:8000/v1 with no auth header if unset.
LOCAL_LLM_API_KEY=your_vllm_server_api_key_here
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct